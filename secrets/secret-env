#!/bin/sh
# Prints one keychain-backed value from secrets.conf, for callers that have no
# shell to source into:
#
#   export AZURE_DEVOPS_PAT=$(~/.config/secrets/secret-env AZURE_DEVOPS_PAT)
#
# A separate file from secret-env.sh on purpose: zsh sets $0 to the sourced
# file, so a "sourced or executed?" check inside the library is portable only
# by accident. Two files, no guesswork.

set -u

. "${SECRET_ENV_DIR:-$HOME/.config/secrets}/secret-env.sh"

[ $# -eq 1 ] || { echo "usage: secret-env VAR_NAME" >&2; exit 2; }

value="$(secret_env_value "$1" || true)"
[ -n "$value" ] || { echo "secret-env: no keychain value for $1" >&2; exit 1; }
printf '%s' "$value"
